{
	"schemaVersion": 1,
	"id": "blendermc",
	"version": "${version}",
	"name": "BlenderMC",
	"description": "Liminal levels made from 3D models instead of blocks, and an endless liminal world.",
	"authors": [],
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.blendermc.BlenderMc"
		],
		"client": [
			"dev.blendermc.client.BlenderMcClient"
		]
	},
	"mixins": [
		"blendermc.mixins.json",
		{
			"config": "blendermc.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
